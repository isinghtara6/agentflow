ENV=dev
ANTHROPIC_API_KEY=sk-ant-...
REDIS_URL=redis://redis:6379/0
# comma-separated client keys accepted by this API (required when ENV=prod)
API_KEYS=change-me-1,change-me-2
STRONG_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
USER_RPM=20
USER_BURST=5
GLOBAL_LLM_RPM=600
DAILY_TOKEN_QUOTA=500000
CACHE_TTL_S=3600
LLM_POLICY_CHECK=true
LOG_LEVEL=INFO
